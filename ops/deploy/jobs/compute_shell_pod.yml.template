# Standalone api-compute pod with the compute-runs PVC mounted at /compute/runs.
# Use for interactive compute runs that need to read or write the artifact tree
# under compute/runs/<run_id>/.
#
# Prereq: compute-runs PVC exists (ops/deploy/base/compute/runs-pvc.yml).
# Note: compute-runs is ReadWriteOnce. Only one pod can mount it at a time —
# if a snapshot-writer Job is running, this pod will stay Pending until it
# finishes.
#
# Usage:
#   cd ops/deploy
#   source ../../.env
#   export IMAGE_TAG="$(cat ../../.image-tag)"
#   envsubst < jobs/compute_shell_pod.yml.template | kubectl apply -f -
#
#   kubectl -n ercotstress exec -it compute-shell -- bash
#   # inside the pod: run a compute entrypoint, e.g. the SF/mu jobs.
#
#   kubectl -n ercotstress delete pod compute-shell   # when done
#
# The pod runs `sleep infinity` so it stays alive for exec. It has no
# restartPolicy=Always, so if you kill the process inside, the pod ends.
#
# Tunables (override via env before envsubst):
#   CPU_REQUEST   Default "2"
#   CPU_LIMIT     Default "2"
#   MEM_REQUEST   Default "2Gi"
#   MEM_LIMIT     Default "8Gi"

apiVersion: v1
kind: Pod
metadata:
  name: compute-shell
  namespace: ercotstress
  labels:
    app: compute-shell
spec:
  restartPolicy: Never
  imagePullSecrets:
    - name: regcred
  containers:
    - name: compute
      image: ${IMAGE_REPO}/ercotstress/api-compute:${IMAGE_TAG}
      command: ["sleep", "infinity"]
      env:
        # Keep RSS near the true working set on this shared node. With several CPUs
        # glibc otherwise fragments allocations across many per-thread arenas and
        # holds freed build-phase memory as RSS into the walk — enough to OOM a job
        # (e.g. the mu ablation) whose live set is well under the limit. ARENA_MAX
        # caps the arenas; TRIM_THRESHOLD_ returns freed pages to the OS promptly.
        # Negligible cost for this large-allocation pandas/numpy/sklearn workload.
        - name: MALLOC_ARENA_MAX
          value: "2"
        - name: MALLOC_TRIM_THRESHOLD_
          value: "0"
        - name: MU_SPILL_PANEL
          value: "${MU_SPILL_PANEL}"
        - name: MU_SPILL_DIR
          value: "${MU_SPILL_DIR}"

      envFrom:
        - configMapRef:
            name: api-config
        - secretRef:
            name: postgres-credentials
      volumeMounts:
        - name: runs
          mountPath: /compute/runs
      resources:
        requests:
          cpu: "${CPU_REQUEST}"
          memory: "${MEM_REQUEST}"
        limits:
          cpu: "${CPU_LIMIT}"
          memory: "${MEM_LIMIT}"
  volumes:
    - name: runs
      persistentVolumeClaim:
        claimName: compute-runs
