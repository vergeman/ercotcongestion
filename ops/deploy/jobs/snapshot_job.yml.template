# Template for running write_snapshots.py on demand against an arbitrary window.
#
# Usage option 1 — edit and apply (good for one-off windows you'll keep around):
#   1. Copy: snapshot-job.yaml.template /tmp/snapshot-job.yaml
#   2. Replace <START>, <END>, <ECR_REPO>, <TAG>, and <SUFFIX> in /tmp/snapshot-job.yaml
#      <SUFFIX> is anything that makes the job name unique, e.g. "20260506" or "test1".
#   3. kubectl apply -f /tmp/snapshot-job.yaml
#   4. kubectl -n ercotstress logs -f job/snapshot-writer-<SUFFIX>
#   5. kubectl -n ercotstress delete job snapshot-writer-<SUFFIX>   # cleanup
#
# Usage option 2 — one-liner via envsubst (good for scripted runs):
#   export START=2026-05-01T00:00:00 END=2026-05-02T00:00:00 \
#     SUFFIX=may1 ECR_REPO=12345.dkr.ecr.us-east-1.amazonaws.com TAG=abc1234
#   envsubst < k8s/12-snapshot-job.yaml.template | kubectl apply -f -
#
# Each apply creates a single-shot Job. Job names must be unique — pick a new
# SUFFIX each time, or delete the prior Job first.

apiVersion: batch/v1
kind: Job
metadata:
  name: snapshot-writer-${SUFFIX}
  namespace: ercotstress
spec:
  backoffLimit: 0          # don't retry on failure; you'll rerun manually
  ttlSecondsAfterFinished: 86400   # auto-delete 24h after completion
  # Long compute window? Bump activeDeadlineSeconds. Default below is 4 hours.
  activeDeadlineSeconds: 14400
  template:
    metadata:
      labels:
        app: snapshot-writer
    spec:
      restartPolicy: Never
      imagePullSecrets:
        - name: regcred
      containers:
        - name: writer
          image: ${IMAGE_REPO}/ercotstress/api-compute:latest
          imagePullPolicy: Always
          command:
            - python
            - /compute/write_snapshots.py
            - --start
            - "${START}"
            - --end
            - "${END}"
          envFrom:
            - configMapRef:
                name: api-config
            - secretRef:
                name: postgres-credentials
          resources:
            requests:
              cpu: "500m"
              memory: "1Gi"
            limits:
              cpu: "4"
              memory: "4Gi"
